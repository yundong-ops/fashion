{
  "name": "fitmate",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite dev",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "embeddings": "node scripts/computeEmbeddings.mjs",
    "mood-tone": "node scripts/computeMoodTone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gradio/client": "^1.6.0",
    "@hono/node-server": "^1.13.7",
    "@imgly/background-removal-node": "^1.4.5",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xenova/transformers": "^2.17.2",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "esbuild@0.17.19": true,
    "bufferutil@4.1.0": true,
    "msw@2.15.0": true,
    "onnxruntime-node@1.17.3": true,
    "protobufjs@6.11.6": true,
    "sharp@0.33.5": true,
    "sharp@0.32.6": true
  }
}
