{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitmate",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // "ai" 바인딩은 마일스톤5(workersai.ts 연동)에서 다시 추가한다.
  // Workers AI는 로컬 에뮬레이션이 없어 바인딩이 선언되면 `vite dev`가
  // 항상 실제 Cloudflare 계정 원격 프록시(CLOUDFLARE_API_TOKEN)를 요구한다 —
  // mock 프로바이더만 쓰는 M1에서는 불필요하므로 뺀다.
  // "ai": { "binding": "AI" },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TRYON_PROVIDER": "mock",
    "TRYON_STRATEGY": "single"
  }
}
